{
	"name": "kilorep",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build:server": "vite build",
		"build:app": "BUILD_TARGET=app vite build",
		"app:sync": "bun run build:app && cap sync android",
		"app:install": "bun run app:sync && cd android && ./gradlew installDebug",
		"start": "node build/server/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"nix:deps-hash": "nix/refresh-deps-hash.sh",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node scripts/seed.ts",
		"account:create": "node scripts/account.ts create",
		"account:list": "node scripts/account.ts list",
		"account:delete": "node scripts/account.ts delete"
	},
	"devDependencies": {
		"@capacitor/android": "8.4.2",
		"@capacitor/cli": "8.4.2",
		"@phosphor-icons/core": "^2.1.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"drizzle-kit": "1.0.0-rc.4",
		"oxlint": "^1.75.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/core": "8.4.2",
		"@capacitor/haptics": "^8.0.2",
		"@internationalized/date": "^3.12.2",
		"bits-ui": "^2.18.1",
		"drizzle-orm": "1.0.0-rc.4"
	}
}
