{
    "name": "kilorep",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "dev:solo": "sh -c 'test -f .env.solo || { echo \"Missing .env.solo — copy .env.example and point DB_FILE_NAME at a scratch db\" >&2; exit 1; }; exec nuxt dev --dotenv .env.solo'",
        "start": "node .output/server/index.mjs",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
        "format": "prettier --ignore-unknown --check .",
        "format:write": "prettier --ignore-unknown --write .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test:isolation": "node tests/isolation.test.mjs",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.2",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@nuxt/icon": "^2.2.3",
        "@tailwindcss/vite": "^4.3.0",
        "@vueuse/nuxt": "14.3.0",
        "better-sqlite3": "^12.10.0",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "nuxt": "^4.4.7",
        "nuxt-auth-utils": "^0.5.29",
        "reka-ui": "^2.9.9",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.35",
        "vue-chartjs": "^5.3.3",
        "vue-router": "^5.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@iconify-json/tabler": "^1.2.35",
        "@types/better-sqlite3": "^7.6.13",
        "@vite-pwa/nuxt": "^1.1.1",
        "drizzle-kit": "^0.31.10",
        "oxlint": "^1.68.0",
        "oxlint-tsgolint": "^0.23.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "vue-tsc": "^3.3.3"
    },
    "version": "0.0.4"
}
