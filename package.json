{
    "name": "kilorep",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "dev:solo": "nuxt dev --dotenv .env.solo",
        "dev:test": "NUXT_IGNORE_LOCK=1 nuxt dev --dotenv .env.test --port 4099",
        "start": "node .output/server/index.mjs",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
        "format": "prettier --ignore-unknown --check .",
        "format:write": "prettier --ignore-unknown --write .",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "openapi:export": "node scripts/export-openapi.mjs && prettier --write --log-level warn openapi/kilorep.json",
        "version": "node scripts/sync-spec-version.mjs && prettier --write --log-level warn openapi/kilorep.json && git add openapi/kilorep.json",
        "test:isolation": "node tests/isolation.test.mjs",
        "test:contract": "node tests/contract.test.mjs",
        "test:unit": "bun test tests/workoutStats.test.ts tests/templateDiff.test.ts tests/workoutDraft.test.ts tests/moveItemTo.test.ts tests/validation.test.ts",
        "test:domain": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.2",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@nuxt/icon": "^2.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/nuxt": "14.3.0",
        "better-sqlite3": "^12.11.1",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "jose": "^6.2.3",
        "nuxt": "^4.5.0",
        "nuxt-auth-utils": "^0.5.29",
        "reka-ui": "^2.10.1",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.40",
        "vue-chartjs": "^5.3.4",
        "vue-router": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@iconify-json/tabler": "^1.2.36",
        "@nuxt/test-utils": "^4.0.3",
        "@seriousme/openapi-schema-validator": "^2.9.0",
        "@types/better-sqlite3": "^7.6.13",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "drizzle-kit": "^0.31.10",
        "happy-dom": "^20.11.0",
        "oxlint": "^1.74.0",
        "oxlint-tsgolint": "^0.25.0",
        "potrace": "^2.1.8",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.7"
    },
    "overrides": {
        "vite": "^8.1.5"
    },
    "version": "0.0.9"
}
