{
    "name": "@kilorep/lift-react",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "React mirror of the Lift design system, built solely to feed claude.ai/design. The Vue components under app/components/ui are the source of truth.",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/lift.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && npm run build:css",
        "build:css": "tailwindcss -i ./src/styles/entry.css -o ./dist/lift.css && mkdir -p ./dist/fonts && cp ../public/fonts/*.woff2 ./dist/fonts/ && sed -i \"s|url('/fonts/|url('./fonts/|g\" ./dist/lift.css",
        "drift": "diff -u ../app/assets/css/main.css ./src/styles/main.css"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-toast": "^1.2.15",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3"
    }
}
