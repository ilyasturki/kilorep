{
    "tab_size": 4,
    "languages": {
        "CSS": {
            "language_servers": ["tailwindcss-language-server"]
        },
        "JSON": {
            // External Prettier: Zed's built-in integration forces parser: 'jsonc', which adds trailing commas. The CLI infers parser from extension and doesn't.
            "formatter": {
                "external": {
                    "command": "./node_modules/.bin/prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "JSONC": {
            "formatter": {
                "external": {
                    "command": "./node_modules/.bin/prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        }
    },
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                "experimental": {
                    // https://www.tailwind-variants.org/docs/getting-started#intellisense-setup-optional
                    "classRegex": [
                        [
                            "([\"'`][^\"'`]*.*?[\"'`])",
                            "[\"'`]([^\"'`]*).*?[\"'`]"
                        ]
                    ]
                }
            }
        }
    }
}
