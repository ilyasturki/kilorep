{
    "schemas": {
        "AuthMode": {
            "type": "object",
            "required": ["authEnabled", "googleClientId"],
            "properties": {
                "authEnabled": { "type": "boolean" },
                "googleClientId": {
                    "type": ["string", "null"],
                    "description": "The Google OAuth client id native sign-in must use as ID-token audience; null on single-user instances."
                }
            }
        },
        "DeviceSignInInput": {
            "type": "object",
            "required": ["idToken"],
            "properties": {
                "idToken": {
                    "type": "string",
                    "description": "A Google ID token obtained on-device (Credential Manager), audience = this instance's Google client id."
                },
                "deviceName": {
                    "type": "string",
                    "description": "Label for the minted device token, shown in web settings."
                }
            }
        },
        "TokenGrant": {
            "type": "object",
            "required": ["token", "record"],
            "properties": {
                "token": {
                    "type": "string",
                    "description": "The bearer token cleartext (kr_…). Returned exactly once; only its hash is stored."
                },
                "record": { "$ref": "#/components/schemas/ApiTokenInfo" }
            }
        },
        "ApiTokenInfo": {
            "type": "object",
            "required": [
                "id",
                "label",
                "tokenPrefix",
                "createdAt",
                "lastUsedAt"
            ],
            "properties": {
                "id": { "type": "integer" },
                "label": { "type": "string" },
                "tokenPrefix": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" },
                "lastUsedAt": {
                    "type": ["string", "null"],
                    "format": "date-time"
                }
            }
        },
        "TokenCreateInput": {
            "type": "object",
            "properties": {
                "label": { "type": "string", "maxLength": 60 }
            }
        },
        "TokenRenameInput": {
            "type": "object",
            "required": ["label"],
            "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
        },
        "MuscleTarget": {
            "type": "object",
            "required": ["muscle", "intensity"],
            "properties": {
                "muscle": { "type": "string" },
                "intensity": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                }
            }
        },
        "Exercise": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "name",
                "equipment",
                "type",
                "muscles",
                "aliases"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "name": { "type": "string" },
                "equipment": {
                    "type": "string",
                    "enum": [
                        "barbell",
                        "dumbbell",
                        "machine",
                        "cable",
                        "bodyweight"
                    ]
                },
                "type": {
                    "type": "string",
                    "enum": ["compound", "isolation"]
                },
                "muscles": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/MuscleTarget" }
                },
                "aliases": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Alternative names the picker searches besides `name`. Gained via merges and the seeded catalog; not editable through the input payload."
                }
            }
        },
        "ExerciseInput": {
            "type": "object",
            "required": ["name", "equipment", "type", "muscles"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "equipment": {
                    "type": "string",
                    "enum": [
                        "barbell",
                        "dumbbell",
                        "machine",
                        "cable",
                        "bodyweight"
                    ]
                },
                "type": {
                    "type": "string",
                    "enum": ["compound", "isolation"]
                },
                "muscles": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/components/schemas/MuscleTarget" }
                }
            }
        },
        "ExerciseHistorySet": {
            "type": "object",
            "required": ["reps", "weight", "done"],
            "properties": {
                "reps": { "type": ["integer", "null"] },
                "weight": { "type": ["number", "null"] },
                "done": { "type": "boolean" }
            }
        },
        "ExerciseHistoryWorkout": {
            "type": "object",
            "required": ["workoutId", "name", "startedAt", "sets"],
            "properties": {
                "workoutId": { "type": "integer" },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" },
                "sets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/components/schemas/ExerciseHistorySet"
                    }
                }
            }
        },
        "ExerciseBestSet": {
            "type": "object",
            "description": "The heaviest set ever logged for an exercise, tie-broken by reps at that load.",
            "required": ["weight", "reps", "workoutId", "name", "startedAt"],
            "properties": {
                "weight": { "type": "number" },
                "reps": { "type": "integer" },
                "workoutId": { "type": "integer" },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" }
            }
        },
        "SessionRef": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" }
            }
        },
        "ExerciseDetail": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "name",
                "equipment",
                "type",
                "muscles",
                "aliases",
                "sessions",
                "history",
                "best"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "name": { "type": "string" },
                "equipment": {
                    "type": "string",
                    "enum": [
                        "barbell",
                        "dumbbell",
                        "machine",
                        "cable",
                        "bodyweight"
                    ]
                },
                "type": {
                    "type": "string",
                    "enum": ["compound", "isolation"]
                },
                "muscles": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/MuscleTarget" }
                },
                "aliases": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "sessions": {
                    "type": "array",
                    "description": "Session templates that program this exercise.",
                    "items": { "$ref": "#/components/schemas/SessionRef" }
                },
                "history": {
                    "type": "array",
                    "description": "Workouts that logged this exercise, newest first.",
                    "items": {
                        "$ref": "#/components/schemas/ExerciseHistoryWorkout"
                    }
                },
                "best": {
                    "anyOf": [
                        { "$ref": "#/components/schemas/ExerciseBestSet" },
                        { "type": "null" }
                    ],
                    "description": "Null when the exercise was never performed with a logged load."
                }
            }
        },
        "ExerciseUsage": {
            "type": "object",
            "description": "Where an exercise is still referenced — carried by the delete 409 so clients can hand over to the merge flow.",
            "required": ["sessions", "workouts"],
            "properties": {
                "sessions": { "type": "integer" },
                "workouts": { "type": "integer" }
            }
        },
        "MergeInput": {
            "type": "object",
            "required": ["targetId"],
            "properties": {
                "targetId": {
                    "type": "integer",
                    "description": "The surviving exercise. The source's references re-point to it and its names live on as aliases."
                }
            }
        },
        "Session": {
            "type": "object",
            "required": ["id", "userId", "name", "position", "createdAt"],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "name": { "type": "string" },
                "position": {
                    "type": "integer",
                    "description": "Manual list order, ascending."
                },
                "createdAt": { "type": "string", "format": "date-time" }
            }
        },
        "PrescribedSet": {
            "type": "object",
            "required": ["id", "sessionExerciseId", "reps", "position"],
            "properties": {
                "id": { "type": "integer" },
                "sessionExerciseId": { "type": "integer" },
                "reps": {
                    "type": ["integer", "null"],
                    "description": "The rep target. Null is an open target: reps are decided at workout time."
                },
                "position": { "type": "integer" }
            }
        },
        "SessionExercise": {
            "type": "object",
            "required": [
                "id",
                "entryId",
                "exerciseId",
                "position",
                "exercise",
                "sets"
            ],
            "properties": {
                "id": { "type": "integer" },
                "entryId": { "type": "integer" },
                "exerciseId": { "type": "integer" },
                "position": {
                    "type": "integer",
                    "description": "Rotation order inside a superset entry."
                },
                "exercise": { "$ref": "#/components/schemas/Exercise" },
                "sets": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/PrescribedSet" }
                }
            }
        },
        "SessionEntry": {
            "type": "object",
            "description": "The top-level ordered unit of a session. One exercise = plain exercise; several = superset rotated through back-to-back.",
            "required": ["id", "sessionId", "position", "exercises"],
            "properties": {
                "id": { "type": "integer" },
                "sessionId": { "type": "integer" },
                "position": { "type": "integer" },
                "exercises": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/SessionExercise" }
                }
            }
        },
        "SessionWithEntries": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "name",
                "position",
                "createdAt",
                "entries"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "name": { "type": "string" },
                "position": { "type": "integer" },
                "createdAt": { "type": "string", "format": "date-time" },
                "entries": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/SessionEntry" }
                }
            }
        },
        "PrescribedSetInput": {
            "type": "object",
            "properties": {
                "reps": {
                    "type": ["integer", "null"],
                    "description": "Anything non-positive normalises to null — an open target."
                }
            }
        },
        "SessionExerciseInput": {
            "type": "object",
            "required": ["exerciseId", "sets"],
            "properties": {
                "exerciseId": { "type": "integer" },
                "sets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/components/schemas/PrescribedSetInput"
                    }
                }
            }
        },
        "SessionEntryInput": {
            "type": "object",
            "required": ["exercises"],
            "properties": {
                "exercises": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/components/schemas/SessionExerciseInput"
                    }
                }
            }
        },
        "SessionInput": {
            "type": "object",
            "required": ["name", "entries"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "entries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/components/schemas/SessionEntryInput"
                    }
                }
            }
        },
        "ReorderInput": {
            "type": "object",
            "required": ["ids"],
            "properties": {
                "ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer" },
                    "description": "Every session id exactly once, in the new order."
                }
            }
        },
        "Workout": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "sessionId",
                "name",
                "startedAt",
                "completed"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "sessionId": {
                    "type": ["integer", "null"],
                    "description": "The session this workout was started from; null once that template is deleted."
                },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" }
            }
        },
        "LoggedSet": {
            "type": "object",
            "required": [
                "id",
                "workoutExerciseId",
                "reps",
                "weight",
                "done",
                "position"
            ],
            "properties": {
                "id": { "type": "integer" },
                "workoutExerciseId": { "type": "integer" },
                "reps": { "type": ["integer", "null"] },
                "weight": {
                    "type": ["number", "null"],
                    "description": "Kilograms; null until entered."
                },
                "done": { "type": "boolean" },
                "position": { "type": "integer" }
            }
        },
        "WorkoutExercise": {
            "type": "object",
            "required": [
                "id",
                "entryId",
                "exerciseId",
                "position",
                "exercise",
                "sets"
            ],
            "properties": {
                "id": { "type": "integer" },
                "entryId": { "type": "integer" },
                "exerciseId": { "type": "integer" },
                "position": { "type": "integer" },
                "exercise": { "$ref": "#/components/schemas/Exercise" },
                "sets": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/LoggedSet" }
                }
            }
        },
        "WorkoutEntry": {
            "type": "object",
            "required": ["id", "workoutId", "position", "exercises"],
            "properties": {
                "id": { "type": "integer" },
                "workoutId": { "type": "integer" },
                "position": { "type": "integer" },
                "exercises": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/WorkoutExercise" }
                }
            }
        },
        "WorkoutWithEntries": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "sessionId",
                "name",
                "startedAt",
                "completed",
                "entries"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "sessionId": { "type": ["integer", "null"] },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" },
                "entries": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/WorkoutEntry" }
                }
            }
        },
        "TemplateChange": {
            "type": "object",
            "description": "One way a workout's tree differs from its template, keyed by exercise so a client can render names from its catalog. 'sets'/'reps' carry the workout's value plus the template's ('was'); 'reordered' is a catch-all order/grouping change. 'reps' deltas are observational — an Update keeps the template's prescribed reps.",
            "required": ["kind"],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": ["added", "removed", "sets", "reps", "reordered"]
                },
                "exerciseId": { "type": "integer" },
                "count": {
                    "type": "integer",
                    "description": "Set count on the workout side (kind 'sets')."
                },
                "was": {
                    "type": ["integer", "null"],
                    "description": "Template's set count (kind 'sets') or prescribed reps (kind 'reps', null when open)."
                },
                "setIndex": {
                    "type": "integer",
                    "description": "Zero-based set position (kind 'reps')."
                },
                "reps": {
                    "type": ["integer", "null"],
                    "description": "Workout's reps at that set (kind 'reps', null when open)."
                }
            }
        },
        "TemplateStatus": {
            "type": "object",
            "description": "A workout's link to its source template: identity, whether its structure has diverged (gates the sync-back affordance), and the itemised changes for the diff view. 'changes' may include rep deltas even when 'diverged' is false, since reps alone never count as structural drift.",
            "required": ["id", "name", "diverged", "changes"],
            "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "diverged": { "type": "boolean" },
                "changes": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/TemplateChange" }
                }
            }
        },
        "WorkoutDetail": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "sessionId",
                "name",
                "startedAt",
                "completed",
                "entries",
                "template"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "sessionId": { "type": ["integer", "null"] },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" },
                "entries": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/WorkoutEntry" }
                },
                "template": {
                    "anyOf": [
                        { "$ref": "#/components/schemas/TemplateStatus" },
                        { "type": "null" }
                    ],
                    "description": "Null when no template survives."
                }
            }
        },
        "WorkoutSaveResult": {
            "type": "object",
            "required": [
                "id",
                "userId",
                "sessionId",
                "name",
                "startedAt",
                "completed",
                "template"
            ],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "sessionId": { "type": ["integer", "null"] },
                "name": { "type": "string" },
                "startedAt": { "type": "string", "format": "date-time" },
                "completed": { "type": "boolean" },
                "template": {
                    "anyOf": [
                        { "$ref": "#/components/schemas/TemplateStatus" },
                        { "type": "null" }
                    ],
                    "description": "Recomputed against the just-persisted tree, so clients track divergence without a follow-up read."
                }
            }
        },
        "StartWorkoutInput": {
            "type": "object",
            "required": ["sessionId"],
            "properties": {
                "sessionId": {
                    "type": "integer",
                    "description": "The session template to copy. Rep targets seed each set; open targets seed from the last logged reps."
                }
            }
        },
        "LoggedSetInput": {
            "type": "object",
            "properties": {
                "reps": { "type": ["integer", "null"] },
                "weight": {
                    "type": ["number", "null"],
                    "description": "Kilograms; negative or non-finite values normalise to null."
                },
                "done": { "type": "boolean", "default": false }
            }
        },
        "WorkoutExerciseInput": {
            "type": "object",
            "required": ["exerciseId", "sets"],
            "properties": {
                "exerciseId": { "type": "integer" },
                "sets": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/components/schemas/LoggedSetInput" }
                }
            }
        },
        "WorkoutEntryInput": {
            "type": "object",
            "required": ["exercises"],
            "properties": {
                "exercises": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/components/schemas/WorkoutExerciseInput"
                    }
                }
            }
        },
        "WorkoutInput": {
            "type": "object",
            "required": ["entries"],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Only applied when non-empty; otherwise the name snapshot stays untouched."
                },
                "completed": { "type": "boolean", "default": false },
                "startedAt": { "type": "string", "format": "date-time" },
                "entries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/components/schemas/WorkoutEntryInput"
                    }
                }
            }
        },
        "ToSessionInput": {
            "type": "object",
            "required": ["mode"],
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["update", "create"],
                    "description": "`update` rewrites the source template in place; `create` makes a new template and re-points the workout at it."
                },
                "name": {
                    "type": "string",
                    "description": "Required when mode is `create`."
                }
            }
        },
        "Bodyweight": {
            "type": "object",
            "required": ["id", "userId", "date", "weight", "createdAt"],
            "properties": {
                "id": { "type": "integer" },
                "userId": { "type": "integer" },
                "date": {
                    "type": "string",
                    "format": "date",
                    "description": "The calendar day weighed (YYYY-MM-DD), one weigh-in per user and day."
                },
                "weight": { "type": "number", "description": "Kilograms." },
                "createdAt": { "type": "string", "format": "date-time" }
            }
        },
        "BodyweightInput": {
            "type": "object",
            "required": ["date", "weight"],
            "properties": {
                "date": { "type": "string", "format": "date" },
                "weight": {
                    "type": "number",
                    "minimum": 20,
                    "maximum": 400,
                    "description": "Kilograms, pinned to two decimals."
                }
            }
        },
        "Ok": {
            "type": "object",
            "required": ["ok"],
            "properties": {
                "ok": { "type": "boolean" }
            }
        },
        "ApiError": {
            "type": "object",
            "description": "h3 error payload. `data` rides along for clients that branch on the cause (e.g. the exercise delete 409 carries ExerciseUsage under `data.usage`).",
            "properties": {
                "statusCode": { "type": "integer" },
                "statusMessage": { "type": "string" },
                "message": { "type": "string" },
                "data": {}
            }
        }
    }
}
