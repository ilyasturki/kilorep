<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat near-black behind the lime rest ring in `ic_launcher_foreground`. The
    hex is the sRGB of oklch(14.5% 0 0), Tailwind's neutral-950 and the app's
    `on-accent` token, written out because Android resources cannot read
    app.css. Near-black rather than lime on purpose: the icon audit found the
    bright-field-with-dark-glyph corner already crowded (LADDER, TrainHeroic,
    HeavySet), while a lime mark on a dark field collides with nobody. The
    layer must stay a fully opaque flat fill so every adaptive mask crops only
    dead field.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0a0a0a"
        android:pathData="M0,0h108v108h-108z" />
</vector>
