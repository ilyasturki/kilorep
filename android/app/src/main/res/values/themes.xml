<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lift is dark-first (ADR-0003); the window background prevents a
         white flash before Compose draws. -->
    <style name="Theme.Kilorep" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lift_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
