<?xml version="1.0" encoding="utf-8"?>
<!--
    The light half of the shell's colours. `values-night/colors.xml` is the same
    four names with the dark values, which is how the native chrome follows the
    OS exactly as app.css does — `@media (prefers-color-scheme: dark)` there,
    the `-night` qualifier here. Neither knows about the other, so both have to
    be changed together.

    Values are the sRGB of the oklch swatches in app.css: canvas is neutral-50,
    accent is blue-600. Android resources cannot read the stylesheet.
-->
<resources>
    <color name="kilorep_canvas">#fafafa</color>

    <!-- Referenced by AppTheme and undefined by Capacitor's template, which is a
         build failure waiting for whoever first shows an action bar. Nothing
         draws them today: the app has no action bar and paints its own chrome. -->
    <color name="colorPrimary">#fafafa</color>
    <color name="colorPrimaryDark">#fafafa</color>
    <color name="colorAccent">#155dfc</color>
</resources>
