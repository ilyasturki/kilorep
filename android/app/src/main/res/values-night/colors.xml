<?xml version="1.0" encoding="utf-8"?>
<!-- The dark half. See values/colors.xml. The accent is *not* the same swatch
     in both themes any more: cobalt needs blue-600 on light grounds and
     blue-500 on dark ones, which is the whole reason these two files carry
     different accents where lime let them share one.

     Canvas is the one value here with no swatch name to give: dark's depth ramp
     leaves the Tailwind neutral scale, for the reason app.css sets out. This is
     the sRGB of that stylesheet's `oklch(21.8% 0 0)`, and it is what the window
     background and the cold-start splash are painted with — so a stale value
     here is a near-black flash on the way into a lighter app. -->
<resources>
    <color name="kilorep_canvas">#1a1a1a</color>

    <color name="colorPrimary">#1a1a1a</color>
    <color name="colorPrimaryDark">#1a1a1a</color>
    <color name="colorAccent">#2b7fff</color>
</resources>
