<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The opt-in to the ahead-of-time back API. Default-on only from API 35, and minSdk is
        24: on a 33/34 device the parser still defaults it to false, so the line is what the
        back animation rests on there rather than decoration.

        Saying yes here is not the same as taking every press. What the app actually wants
        is pushed at runtime from `src/lib/nav/hardware-back.ts`, screen by screen.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            Portrait only. DESIGN.md's whole frame is "one hand, phone at arm's
            length on a bench" and every screen is laid out for a single thumb
            column; landscape would be a second layout nobody has designed and
            nobody in a gym asked for. Reversible in one line if that turns out
            to be wrong on a tablet.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Long-press shortcuts. Declared on the launcher activity because that is
                the icon they hang off; see `res/xml/shortcuts.xml` for what they do and
                why their intents name this component outright.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
                The way back in from a Google sign-in, which has to happen in a
                Custom Tab because Google refuses OAuth inside a WebView. The
                scheme is the applicationId verbatim, taken from the string
                resource Capacitor already generates for it rather than written
                out again; `DEVICE_REDIRECT` in src/lib/api/routes.ts is the
                same string on the other side, and the server redirects to it.

                A custom scheme is claimed, not owned — any app may register
                this one and Android will offer the user a choice. That is why
                the URL carries a single-use code bound to a PKCE challenge
                rather than the token itself; see `googleCodes` in the schema.
                An https App Link would be exclusive, but it needs an
                assetlinks.json on a domain we control, and the server's domain
                belongs to whoever self-hosted it.

                `singleTask` above is what makes this arrive at the running
                instance as `appUrlOpen` rather than starting a second one.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The rest timer's alarm. `POST_NOTIFICATIONS`, `WAKE_LOCK` and
        `RECEIVE_BOOT_COMPLETED` are declared by the local-notifications plugin
        itself and merge in from there; this one does not, and without it
        Android 12+ silently downgrades an exact alarm to an inexact one —
        delivered whenever Doze next wakes, which for a two-minute rest can be
        many minutes late.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
