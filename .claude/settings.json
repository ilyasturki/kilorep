{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/format.sh",
						"statusMessage": "Formatting",
						"timeout": 60
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/gate.sh",
						"statusMessage": "Checking formatting",
						"timeout": 120
					}
				]
			}
		]
	}
}
