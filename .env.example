# Copy to `.env`. It is loaded by `src/lib/server/db/config.ts`, which the
# server, the seed script and drizzle-kit all import — so one file configures
# all three. A real environment variable always wins, so a container ignores it.

# The SQLite file. One per instance; the directory is created on first run.
# Mount this path as a volume when running the container — it is the database.
DATABASE_PATH=.data/kilorep.db

# Where the generated SQL migrations live. Only set this if the folder moves;
# the server applies them at boot and the container must ship them.
# MIGRATIONS_DIR=drizzle
