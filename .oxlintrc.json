{
	"$schema": "./node_modules/oxlint/configuration_schema.json",

	// Hard config: every category is an error except `nursery`, so rules added by an
	// oxlint upgrade arrive switched ON. Everything switched off below is switched off
	// for a stated reason. Do not add a silent exception — if a rule has to go, say why.

	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],

	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error",
		"pedantic": "error",
		"style": "error",
		"restriction": "error",
		"nursery": "off"
	},

	"env": { "browser": true, "es2024": true },

	"options": {
		// Type-aware rules (no-floating-promises, no-unnecessary-condition,
		// switch-exhaustiveness-check, …) — this is where the real strictness is.
		// Requires the `oxlint-tsgolint` dev dependency.
		"typeAware": true,
		// A suppression that no longer suppresses anything is a lie about the code.
		"reportUnusedDisableDirectives": "error"
	},

	"ignorePatterns": [
		// Agent worktrees are whole checkouts of this repo, each carrying its own copy
		// of this file. oxlint walks into them, finds `options.typeAware` in a config
		// that is no longer the root one, and dies on the parse before it lints a line —
		// so without this, `bun run lint` cannot run at all while a worktree exists, and
		// CI becomes the first place anything is checked.
		".claude/",
		".svelte-kit/",
		"build/",
		"dist/",
		"static/",
		"android/",
		"ios/",
		"src/lib/paraglide/"
	],

	"rules": {
		// --- Formatting and ordering: prettier owns layout, and the rest is churn ---
		"sort-keys": "off", // fights domain-meaningful field order
		"sort-imports": "off",
		"sort-vars": "off",
		"capitalized-comments": "off", // this codebase writes lowercase comments
		"no-inline-comments": "off",

		// --- Contradictory pairs. `style` + `restriction` ship both halves; pick one. ---
		// Named exports win: `export const ssr = false` is the SvelteKit contract.
		"import/no-named-export": "off",
		"import/prefer-default-export": "off",
		"import/group-exports": "off", // `export const ssr` / `export const prerender` are separate by idiom
		"import/exports-last": "off",
		// `consistent-type-specifier-style` demands a separate top-level `import type`,
		// which `no-duplicate-imports` then calls a duplicate of the value import from
		// the same module. Only one can hold; the type-only import is the useful half,
		// because it is the one a bundler can erase.
		"no-duplicate-imports": "off",
		// `import/no-default-export` stays ON for src/ — see the config-file override.

		// --- Language features this project uses deliberately ---
		"no-ternary": "off", // reactive UI code is ternaries; `no-nested-ternary` stays on
		"no-undefined": "off", // `undefined` vs `null` is load-bearing in the sync protocol
		"unicorn/no-null": "off", // SQLite, JSON payloads and tombstones all carry null
		"no-magic-numbers": "off", // domain math and UI constants
		"no-plusplus": "off",
		"id-length": "off", // `i`, `id`, `kg`, `rm`
		"func-style": "off",
		"no-continue": "off",
		"no-negated-condition": "off",
		"no-else-return": "off",
		"init-declarations": "off",
		"no-void": "off",
		"prefer-destructuring": "off",
		"no-await-in-loop": "off", // sequential IndexedDB and sync writes are intentional
		"unicorn/no-array-reduce": "off", // volume totals are a reduce
		"import/no-unassigned-import": "off", // `import './app.css'`
		"no-warning-comments": "off", // banning the word TODO does not remove the work
		"oxc/no-async-await": "off", // persistence and sync are async end to end
		// Superseded by type-aware `switch-exhaustiveness-check`, which is strictly
		// better: a dead `default` on an exhaustive union switch is worse than no default.
		"default-case": "off",

		// `type` over `interface`: the domain is discriminated unions and mapped types,
		// which `interface` cannot express. One spelling, not two.
		"typescript/consistent-type-definitions": ["error", "type"],

		// --- Arbitrary numeric limits: taste, not defects. Splitting a function to
		// --- satisfy a line count makes the code worse. `max-depth` stays on.
		"max-lines": "off",
		"max-lines-per-function": "off",
		"max-statements": "off",
		"max-params": "off",
		"max-nested-callbacks": "off",
		"import/max-dependencies": "off",

		// --- Rules that are wrong here, not merely strict ---
		"no-undef": "off", // TypeScript's job; false-positives on ambient globals
		"typescript/prefer-readonly-parameter-types": "off", // demands deep-readonly on every DOM and third-party type

		// --- Hard rule 6: no proprietary SDKs. Ever. See CLAUDE.md. ---
		// Duplicated in the domain override below — an override replaces a rule's
		// config rather than merging it, so both copies must carry these patterns.
		"no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"group": [
							"firebase",
							"firebase/*",
							"@firebase/*",
							"@react-native-firebase/*",
							"@revenuecat/*",
							"purchases-*",
							"posthog-js",
							"mixpanel-browser",
							"@amplitude/*",
							"@segment/*",
							"@sentry/*",
							"@google-analytics/*",
							"react-ga*"
						],
						"message": "No proprietary SDKs — no Firebase, no analytics, no RevenueCat. CLAUDE.md hard rule 6."
					}
				]
			}
		]
	},

	"overrides": [
		{
			// Hard rule 1: the domain, store and sync layer imports no framework.
			// Plain TypeScript, testable with `bun test`, portable if the UI is rewritten.
			"files": ["src/lib/domain/**", "src/lib/store/**", "src/lib/sync/**", "src/lib/db/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"svelte",
									"svelte/*",
									"@sveltejs/*",
									"$app/*",
									"$env/*",
									"bits-ui",
									"@capacitor/*",
									"*.svelte"
								],
								"message": "The domain, store and sync layer imports no framework — plain TypeScript only. CLAUDE.md hard rule 1."
							},
							{
								"group": [
									"firebase",
									"firebase/*",
									"@firebase/*",
									"@react-native-firebase/*",
									"@revenuecat/*",
									"purchases-*",
									"posthog-js",
									"mixpanel-browser",
									"@amplitude/*",
									"@segment/*",
									"@sentry/*",
									"@google-analytics/*",
									"react-ga*"
								],
								"message": "No proprietary SDKs — no Firebase, no analytics, no RevenueCat. CLAUDE.md hard rule 6."
							}
						]
					}
				]
			}
		},
		{
			// Runes are `let`, always: `let x = $state(0)`, `let { children } = $props()`.
			// oxlint reads the script block without the compiler, so it cannot see that
			// the compiler reassigns these — `prefer-const` is a guaranteed false positive.
			"files": ["**/*.svelte", "**/*.svelte.ts", "**/*.svelte.js"],
			"rules": {
				"prefer-const": "off",
				// A script block with no import and no export is an ordinary component.
				"import/unambiguous": "off",
				// Component-local handlers infer `void` and have no consumer to protect.
				// `explicit-module-boundary-types` still guards anything exported.
				"typescript/explicit-function-return-type": "off",
				// Capitalisation is syntax in a Svelte template, not taste: `<SetRow />`
				// compiles to a component and `<setrow />` to an unknown element. The file
				// name is the import name, so components are PascalCase. Route files are
				// named by SvelteKit (`+page.svelte`) and are not ours to case either.
				"unicorn/filename-case": "off",
				// Every callback prop in Svelte 5 is optional by construction —
				// `onclick?.()`, `{@render children?.()}` — and the framework's own docs
				// are written that way. Banning `?.` here bans the idiom, and the
				// `if (x) x()` rewrite is the same nullability with more lines.
				"oxc/no-optional-chaining": "off",
				// `let { a, ...rest } = $props()` then `{...rest}` is how a component
				// forwards the attributes it does not itself consume. There is no
				// enumerable alternative: the set is every attribute the element accepts.
				"oxc/no-rest-spread-properties": "off"
			}
		},
		{
			// The root layout is the one file that owns the global stylesheet, and
			// `src/app.css` sits above `src/routes/` by SvelteKit's layout. `$lib` cannot
			// reach it and moving the file would break the framework contract, so the
			// relative parent import is correct here and nowhere else.
			"files": ["src/routes/+layout.svelte"],
			"rules": {
				"import/no-relative-parent-imports": "off"
			}
		},
		{
			// Build and tooling config: a default export is the contract.
			"files": ["*.config.ts", "*.config.js", "svelte.config.js", "capacitor.config.ts"],
			"env": { "node": true, "browser": false },
			"rules": {
				"import/no-default-export": "off",
				// `BUILD_TARGET` picks the adapter in vite.config.ts, and drizzle.config.ts
				// resolves the same `DATABASE_PATH` the server does. Both are build-time
				// Node, where the environment is the only channel available.
				"node/no-process-env": "off",
				// Config files run in Node before any bundle exists.
				"import/no-nodejs-modules": "off"
			}
		},
		{
			// The server. Node by definition — it is the one place in this repo that is
			// never bundled for a browser or a WebView, and `$lib/server` is a boundary
			// SvelteKit enforces at build time.
			"files": ["src/lib/server/**", "src/hooks.server.ts", "scripts/**"],
			"env": { "node": true, "browser": false },
			"rules": {
				// node:sqlite, node:crypto, node:fs — the whole point of this layer.
				"import/no-nodejs-modules": "off",
				// `DatabaseSync` and `mkdirSync` are synchronous because SQLite and the
				// boot path offer nothing else. Password hashing is the exception that
				// proves it: `crypto.scrypt` *does* have an async form, so it uses it —
				// see the note in `auth/password.ts`.
				"node/no-sync": "off",
				// Configuration reaches a container through its environment. Read in
				// `db/config.ts` and nowhere else.
				"node/no-process-env": "off",
				// The same argument as the endpoint override below, and the same
				// process: this layer answers with a status and puts the detail in the
				// log, because the detail is the internals and the caller is a stranger.
				// The hook logs the database error behind its 503; `config.ts` names the
				// `CORS_ORIGINS` entry it had to drop, which silence would turn into an
				// app that reports a network error for no discoverable reason.
				"no-console": "off",
				// The server tree is `db/` and `auth/`, which reference each other. The
				// alternative is flattening a layer that has a real internal structure.
				"import/no-relative-parent-imports": "off"
			}
		},
		{
			// Endpoints. Node by the same argument as `src/lib/server`, and the process
			// log is the only channel they have for detail a response deliberately
			// withholds — `/api/health` answers 503 and logs why. A swallowed error on
			// a self-hosted box is a support ticket with nothing in it.
			"files": ["src/routes/api/**"],
			"env": { "node": true, "browser": false },
			"rules": {
				"no-console": "off"
			}
		},
		{
			// One-shot command-line tools. Their stdout *is* the interface — `db:seed`
			// prints the credentials it just created — and an exit code is how a shell
			// learns the outcome. A thrown stack trace communicates neither.
			"files": ["scripts/**"],
			"rules": {
				"no-console": "off",
				"unicorn/no-process-exit": "off",
				// The rule protects published modules from `require(esm)`. These are
				// `node scripts/…` entry points, required by nothing.
				"node/no-top-level-await": "off"
			}
		},
		{
			// `export {}` marks an ambient file as a module — it is meant to be empty.
			"files": ["**/*.d.ts"],
			"rules": {
				"unicorn/require-module-specifiers": "off",
				"typescript/consistent-type-definitions": "off"
			}
		},
		{
			// The one test tree outside `src/`, because its subject is: `scripts/seed/`
			// is dev tooling, reached by `node scripts/…` and by nothing the app bundles,
			// so it has no `$lib` alias and gets none — an alias into it is an invitation
			// to import seed data from a screen. That leaves the parent-relative import
			// the only way in, and the rule's three suggestions all make it worse: moving
			// the file puts a test in the script tree, injecting the dependency means the
			// test no longer names what it tests, and a package for one seed is absurd.
			"files": ["tests/**"],
			"rules": {
				"import/no-relative-parent-imports": "off"
			}
		},
		{
			// Ambient declarations are scripts, not modules. `declare module 'potrace'`
			// only declares an untyped package from a file with no top-level import or
			// export; adding one to satisfy the rule turns the block into a module
			// augmentation, which TypeScript rejects against a package that ships no
			// types of its own. `src/app.d.ts` has imports, is a module, and passes the
			// rule without this.
			"files": ["**/*.d.ts"],
			"rules": {
				"import/unambiguous": "off"
			}
		},
		{
			// vitest — jest-compatible API, so the jest rules apply.
			"files": ["**/*.test.ts", "**/*.spec.ts", "**/*.test.js", "**/*.spec.js"],
			"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "jest"],
			"rules": {
				"typescript/no-non-null-assertion": "off",
				"typescript/no-unsafe-type-assertion": "off"
			}
		}
	]
}
