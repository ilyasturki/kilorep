{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vue"],
    "categories": {
        // "nursery": "warn"
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
        // "pedantic": "warn"
    },
    "options": {
        "typeAware": true
    },
    "env": {
        "browser": true,
        "es2024": true,
        "node": true
    }
}
