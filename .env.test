# Auth-mode instance for the two-user isolation suite (`bun run test:isolation`).
# Pure test fixtures, no real secrets. Start it with `bun run dev:test` (serves
# on :4099); the single-user instance on :4097 is booted by the test itself.
#
# These values must match the test's hardcoded fallbacks: client id "x", this
# exact 41-char password, and the .data/test-auth.db path. Change one here and
# device sign-in / session forging stop lining up.

# Presence of the OAuth pair is what flips the app into multi-user mode.
NUXT_OAUTH_GOOGLE_CLIENT_ID=x
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=y

# Seals session cookies; the suite forges sessions with this same password.
NUXT_SESSION_PASSWORD=test-password-at-least-32-characters-long

# Verify device ID tokens against the suite's own JWKS server, not Google's.
NUXT_GOOGLE_JWKS_URL=http://localhost:4098/jwks

# Throwaway DB so the suite never touches the dev database.
DB_FILE_NAME=.data/test-auth.db
